{
  "name": "indios-churrasco-gourmet-monorepo",
  "version": "2.9.0",
  "description": "Monorepo — Índios Churrasco Gourmet (Dashboard SaaS)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "node -e \"if (process.env.CI !== 'true') { const { execSync } = require('child_process'); try { execSync('husky', { stdio: 'inherit' }); } catch (e) { console.log('Husky not installed or failed'); } }\"",
    "commit": "git-cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "lint:commits:ci": "commitlint --from origin/main --to HEAD --verbose",
    "sync:versions": "node scripts/sync-versions.js",
    "sync:changelog": "node scripts/sync-changelog-from-github.js",
    "clean:cache": "node -e \"const fs=require('fs');const p='frontend/node_modules/.vite';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true});console.log('[OK] Cache limpo com sucesso')}else{console.log('[INFO] Cache já estava limpo')}\"",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.3",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.4",
    "semantic-release": "^24.0.0",
    "sharp": "^0.33.5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@api/focus-nfe": "file:.api/apis/focus-nfe",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1"
  }
}
